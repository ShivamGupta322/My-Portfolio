# Copy to .env.local and fill in.

# Canonical site URL (metadata, OG images, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.devshivam.online

# Optional: a GitHub token (no scopes needed) raises the API rate limit for
# the "On GitHub" card. Works without it.
GITHUB_TOKEN=

# Contact form (Resend). Without RESEND_API_KEY + CONTACT_TO_EMAIL the form
# still works: visitors get a ready-to-send email (mailto) instead.
RESEND_API_KEY=
# Inbox that receives messages
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <hello@devshivam.online>".
# Defaults to Resend's test sender, which only delivers to your Resend account's own email.
CONTACT_FROM_EMAIL=
